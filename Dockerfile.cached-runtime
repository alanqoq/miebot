ARG BASE_IMAGE=miebot:runtime-cache-dragonwell21
FROM ${BASE_IMAGE}

USER root

# The cached runtime must come from the updated main Dockerfile. Exercise the
# inherited AWT/font stack before copying artifacts so stale cache images fail.
RUN set -eu; \
    fail() { echo "Dockerfile.cached-runtime: cached base image validation failed: $*" >&2; exit 1; }; \
    case "${JAVA_TOOL_OPTIONS-}" in \
        *"-Djava.awt.headless=true"*) ;; \
        *) fail "JAVA_TOOL_OPTIONS lacks -Djava.awt.headless=true; rebuild the cache base from Dockerfile" ;; \
    esac; \
    command -v fc-match >/dev/null 2>&1 || fail "fontconfig is missing (fc-match not found)"; \
    font_family="$(fc-match -f '%{family}\n' 'Noto Sans CJK SC' | sed -n '1p')"; \
    printf '%s\n' "$font_family" | grep -qi 'Noto Sans CJK' || fail "Noto CJK font is not selected (fc-match returned '$font_family')"; \
    printf '%s\n' \
        'import java.awt.image.BufferedImage;' \
        'final class AwtRuntimeCheck {' \
        '    public static void main(String[] args) {' \
        '        var image = new BufferedImage(8, 8, BufferedImage.TYPE_INT_ARGB);' \
        '        var graphics = image.createGraphics();' \
        '        try {' \
        '            graphics.getFontMetrics().stringWidth("MieBot font metrics");' \
        '        } finally {' \
        '            graphics.dispose();' \
        '        }' \
        '    }' \
        '}' > /tmp/AwtRuntimeCheck.java; \
    if ! /opt/dragonwell/bin/java /tmp/AwtRuntimeCheck.java; then \
        fail "headless font-metrics smoke test failed"; \
    fi; \
    rm -f /tmp/AwtRuntimeCheck.java

# A reused runtime cache may include artifacts from an earlier candidate.
RUN rm -rf /app/* /modules/* /plugins/*

COPY --chown=10001:10001 qqbot-app.jar /app/qqbot-app.jar
COPY --chown=10001:10001 modules/ /modules/
COPY --chown=10001:10001 plugins/qqbot-plugin-example.jar /plugins/qqbot-plugin-example.jar

RUN rm -rf /opt/sqlite/* /tmp/qqbot-jar \
    && mkdir -p /tmp/qqbot-jar /opt/sqlite \
    && cd /tmp/qqbot-jar \
    && /opt/dragonwell/bin/jar -xf /app/qqbot-app.jar \
    && sqlite_jar="$(find BOOT-INF/lib -maxdepth 1 -name 'sqlite-jdbc-*.jar' -print -quit)" \
    && test -n "$sqlite_jar" \
    && cd /opt/sqlite \
    && /opt/dragonwell/bin/jar -xf "/tmp/qqbot-jar/$sqlite_jar" org/sqlite/native/Linux/x86_64/libsqlitejdbc.so \
    && mv org/sqlite/native/Linux/x86_64/libsqlitejdbc.so . \
    && chmod 0555 /opt/sqlite/libsqlitejdbc.so \
    && rm -rf /tmp/qqbot-jar /opt/sqlite/org

ENV QQBOT_MODULES_DIR=/modules \
    LOADER_PATH=/modules \
    QQBOT_PLUGINS_DATA_DIR=/data/plugin-data \
    QQBOT_MEDIA_STAGING_DIRECTORY=/data/media-staging

USER 10001:10001

ENTRYPOINT ["/opt/dragonwell/bin/java", "-cp", "/app/qqbot-app.jar", "org.springframework.boot.loader.launch.PropertiesLauncher"]
