ARG BASE_IMAGE=mirai-qqbot:runtime-cache-dragonwell21
FROM ${BASE_IMAGE}

USER root

COPY --chown=10001:10001 qqbot-app.jar /app/qqbot-app.jar
COPY --chown=10001:10001 modules/ /modules/
COPY --chown=10001:10001 plugins/qqbot-plugin-echo.jar /plugins/qqbot-plugin-echo.jar

RUN rm -rf /opt/sqlite/* /tmp/qqbot-jar \
    && mkdir -p /tmp/qqbot-jar /opt/sqlite \
    && cd /tmp/qqbot-jar \
    && /opt/dragonwell/bin/jar -xf /app/qqbot-app.jar \
    && sqlite_jar="$(find BOOT-INF/lib -maxdepth 1 -name 'sqlite-jdbc-*.jar' -print -quit)" \
    && test -n "$sqlite_jar" \
    && cd /opt/sqlite \
    && /opt/dragonwell/bin/jar -xf "/tmp/qqbot-jar/$sqlite_jar" org/sqlite/native/Linux/x86_64/libsqlitejdbc.so \
    && mv org/sqlite/native/Linux/x86_64/libsqlitejdbc.so . \
    && chmod 0555 /opt/sqlite/libsqlitejdbc.so \
    && rm -rf /tmp/qqbot-jar /opt/sqlite/org

ENV QQBOT_MODULES_DIR=/modules \
    LOADER_PATH=/modules \
    QQBOT_PLUGINS_DATA_DIR=/data/plugin-data \
    QQBOT_MEDIA_STAGING_DIRECTORY=/data/media-staging

USER 10001:10001

ENTRYPOINT ["/opt/dragonwell/bin/java", "-cp", "/app/qqbot-app.jar", "org.springframework.boot.loader.launch.PropertiesLauncher"]
